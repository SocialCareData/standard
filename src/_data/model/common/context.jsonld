{
  "@context": {
    "sc": "https://ns.socialcaredata.io/",
    "auc": "https://ns.socialcaredata.io/address-use-code#",
    "nuc": "https://ns.socialcaredata.io/name-use-code#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "ex": "https://example.org/common/",
    "Address": {
      "@id": "sc:Address",
      "@context": {
        "use": {
          "@id": "sc:use",
          "@type": "@vocab",
          "@context": {
            "@vocab": "https://ns.socialcaredata.io/address-use-code#",
            "Temporary": "auc:Temp",
            "billing": "auc:Billing",
            "home": "auc:Home",
            "old": "auc:Old",
            "temp": "auc:Temp",
            "work": "auc:Work"
          }
        }
      }
    },
    "AssessmentQuestion": "sc:AssessmentQuestion",
    "Contact": "sc:Contact",
    "Identifier": "sc:Identifier",
    "Name": {
      "@id": "sc:Name",
      "@context": {
        "use": {
          "@id": "sc:use",
          "@type": "@vocab",
          "@context": {
            "@vocab": "https://ns.socialcaredata.io/name-use-code#",
            "Maiden name": "nuc:Maiden",
            "Official name": "nuc:Official",
            "Old name": "nuc:Old",
            "Temporary name": "nuc:Temp",
            "Usual name": "nuc:Usual",
            "anonymous": "nuc:Anonymous",
            "maiden": "nuc:Maiden",
            "nickname": "nuc:Nickname",
            "official": "nuc:Official",
            "old": "nuc:Old",
            "temp": "nuc:Temp",
            "usual": "nuc:Usual"
          }
        }
      }
    },
    "Timing": "sc:Timing",
    "UPRN": "sc:UPRN",
    "USRN": "sc:USRN",
    "addressUse": {
      "@id": "sc:use",
      "@type": "@vocab",
      "@context": {
        "@vocab": "https://ns.socialcaredata.io/address-use-code#",
        "Temporary": "auc:Temp",
        "billing": "auc:Billing",
        "home": "auc:Home",
        "old": "auc:Old",
        "temp": "auc:Temp",
        "work": "auc:Work"
      }
    },
    "answer": {
      "@id": "sc:answer",
      "@container": "@set"
    },
    "answerType": {
      "@id": "sc:answerType",
      "@type": "@vocab",
      "@context": {
        "@vocab": "https://ns.socialcaredata.io/answer-type#"
      }
    },
    "category": "sc:category",
    "city": "sc:city",
    "contactName": "sc:contactName",
    "email": {
      "@id": "sc:email",
      "@container": "@set"
    },
    "endDateTime": {
      "@id": "sc:endDateTime",
      "@type": "xsd:dateTime"
    },
    "familyName": {
      "@id": "sc:familyName",
      "@container": "@set"
    },
    "frequency": {
      "@id": "sc:frequency",
      "@type": "@json"
    },
    "givenName": {
      "@id": "sc:givenName",
      "@container": "@set"
    },
    "line1": "sc:line1",
    "line2": "sc:line2",
    "name": "sc:contactName",
    "nameUse": {
      "@id": "sc:use",
      "@type": "@vocab",
      "@context": {
        "@vocab": "https://ns.socialcaredata.io/name-use-code#",
        "Maiden name": "nuc:Maiden",
        "Official name": "nuc:Official",
        "Old name": "nuc:Old",
        "Temporary name": "nuc:Temp",
        "Usual name": "nuc:Usual",
        "anonymous": "nuc:Anonymous",
        "maiden": "nuc:Maiden",
        "nickname": "nuc:Nickname",
        "official": "nuc:Official",
        "old": "nuc:Old",
        "temp": "nuc:Temp",
        "usual": "nuc:Usual"
      }
    },
    "postcode": "sc:postcode",
    "preferredName": "sc:preferredName",
    "questionId": "sc:questionId",
    "questionText": "sc:questionText",
    "required": {
      "@id": "sc:required",
      "@type": "xsd:boolean"
    },
    "startDateTime": {
      "@id": "sc:startDateTime",
      "@type": "xsd:dateTime"
    },
    "system": {
      "@id": "sc:system",
      "@type": "@id"
    },
    "telephone": {
      "@id": "sc:telephone",
      "@container": "@set"
    },
    "value": "sc:value"
  }
}
