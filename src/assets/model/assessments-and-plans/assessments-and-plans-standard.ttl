<https://ns.socialcaredata.io/person/Identifier> a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:value ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:system ] ;
    skos:definition "A single identifier for a person, comprising the value and the system in whose namespace the value is unique. Aligned with FHIR Identifier and the NHS PDS UNIQUE_REFERENCE definition." ;
    skos:exactMatch <https://ns.socialcaredata.io/person/Identifier> ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

