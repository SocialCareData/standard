@prefix act: <https://ns.socialcaredata.io/assessments-and-plans/care-actor-type#> .
@prefix ap: <https://ns.socialcaredata.io/assessments-and-plans/> .
@prefix apc: <https://ns.socialcaredata.io/assessments-and-plans/care-outcome-type#> .
@prefix at: <https://ns.socialcaredata.io/assessments-and-plans/answer-type#> .
@prefix cds: <https://ns.socialcaredata.io/assessments-and-plans/care-document-status#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix es: <https://ns.socialcaredata.io/assessments-and-plans/eligibility-status#> .
@prefix fs: <https://ns.socialcaredata.io/assessments-and-plans/funding-status#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix qc: <https://ns.socialcaredata.io/assessments-and-plans/question-category#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sq: <https://ns.socialcaredata.io/assessments-and-plans/statutory-question-id#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ap:previousId a owl:ObjectProperty ;
    rdfs:label "previousId" ;
    rdfs:range <https://ns.socialcaredata.io/person/Identifier> ;
    skos:definition "A link to the previous assessment / plan that is being reviewed." ;
    skos:inScheme ap:schema .

ap:schema.owl.ttl a owl:Ontology ;
    rdfs:label "assessments-and-plans" ;
    dct:license "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" ;
    dct:title "Standards for Care Needs Assessments and Care Plans Data Model" ;
    pav:version "1.0.0" ;
    skos:definition "A single LinkML data model for the Care Needs Assessments and Care Plans Standard (PUB05). This standard defines the shared, back-end fields of information for assessments and care plans." .

ap:serviceEpisodeId a owl:ObjectProperty ;
    rdfs:label "serviceEpisodeId" ;
    rdfs:range <https://ns.socialcaredata.io/person/Identifier> ;
    skos:definition "Identifier for the safeguarding or care service episode during which this assessment / plan was completed." ;
    skos:inScheme ap:schema .

<https://ns.socialcaredata.io/person/address> a owl:ObjectProperty ;
    rdfs:label "address" ;
    rdfs:range <https://ns.socialcaredata.io/person/Address> ;
    skos:definition "Physical addresses where the person can be contacted." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/communication> a owl:ObjectProperty ;
    rdfs:label "communication" ;
    rdfs:range <https://ns.socialcaredata.io/person/Communication> ;
    skos:definition "Professional recording of a person's communication requirements and language proficiencies." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/contact> a owl:ObjectProperty ;
    rdfs:label "contact" ;
    rdfs:range <https://ns.socialcaredata.io/person/Contact> ;
    skos:definition "The person's contact information." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/email> a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:range xsd:string ;
    skos:definition "One or more email addresses." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/language> a owl:ObjectProperty ;
    rdfs:label "language" ;
    rdfs:range <https://ns.socialcaredata.io/person/Language> ;
    skos:definition "Specific language(s) spoken or understood by the person, optionally annotated with proficiency." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/matchedPersonRef> a owl:ObjectProperty ;
    rdfs:label "matchedPersonRef" ;
    rdfs:range <https://ns.socialcaredata.io/person/Identifier> ;
    skos:definition "References to other Person records where a cross-system match has been identified. Uses the Identifier structure." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/primaryContactProfessional> a owl:ObjectProperty ;
    rdfs:label "primaryContactProfessional" ;
    rdfs:range <https://ns.socialcaredata.io/person/Identifier> ;
    skos:definition "References to the primary professionals related to this person (e.g. care coordinators or a GP). Until the Professional standard is published, recorded using the Identifier structure (system + value)." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/relatedPerson> a owl:ObjectProperty ;
    rdfs:label "relatedPerson" ;
    rdfs:range <https://ns.socialcaredata.io/person/PersonRelationship> ;
    skos:definition "References to other people related to this person, with the kind of relationship." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/telephone> a owl:DatatypeProperty ;
    rdfs:label "telephone" ;
    rdfs:range xsd:string ;
    skos:definition "One or more telephone numbers." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

ap:CareNeedsAssessment a owl:Class ;
    rdfs:label "CareNeedsAssessment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ap:planId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:status ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ap:assessmentQuestion ],
        ap:FoundationalInformation ;
    skos:definition "A Care Needs Assessment record, completed when an adult contacts or is referred to a local authority's social services team." ;
    skos:exactMatch ap:CareNeedsAssessment ;
    skos:inScheme ap:schema .

ap:CarePlan a owl:Class ;
    rdfs:label "CarePlan" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:status ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ap:careComponent ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:assessmentId ],
        ap:FoundationalInformation ;
    skos:definition "A Care Plan record, created immediately after an assessment if the person is found to be eligible." ;
    skos:exactMatch ap:CarePlan ;
    skos:inScheme ap:schema .

ap:activity a owl:ObjectProperty ;
    rdfs:label "activity" ;
    rdfs:range ap:CareActivity ;
    skos:definition "The activity details of this component of the plan." ;
    skos:inScheme ap:schema .

ap:activityDescription a owl:DatatypeProperty ;
    rdfs:label "activityDescription" ;
    rdfs:range xsd:string ;
    skos:definition "Text description of the care component." ;
    skos:inScheme ap:schema .

ap:actor a owl:ObjectProperty ;
    rdfs:label "actor" ;
    rdfs:range ap:CareActor ;
    skos:definition "The actors performing this component of the plan." ;
    skos:inScheme ap:schema .

ap:actorId a owl:ObjectProperty ;
    rdfs:label "actorId" ;
    rdfs:range <https://ns.socialcaredata.io/person/Identifier> ;
    skos:definition "The ID of the person performing the item of the plan (Person ID, professional ID, or service ID)." ;
    skos:inScheme ap:schema .

ap:actorType a owl:ObjectProperty ;
    rdfs:label "actorType" ;
    rdfs:range ap:care-actor-type ;
    skos:definition "The type of person performing the component of the plan." ;
    skos:inScheme ap:schema .

ap:advocateRequired a owl:DatatypeProperty ;
    rdfs:label "advocateRequired" ;
    rdfs:range xsd:boolean ;
    skos:definition "Does the person require an advocate to complete this assessment / plan?" ;
    skos:inScheme ap:schema .

ap:answer a owl:DatatypeProperty ;
    rdfs:label "answer" ;
    rdfs:range xsd:string ;
    skos:definition "The answer to the question as measured in the assessment." ;
    skos:inScheme ap:schema .

ap:answerType a owl:ObjectProperty ;
    rdfs:label "answerType" ;
    rdfs:range ap:answer-type ;
    skos:definition "Indicates how the answer should be parsed (e.g., String, Boolean, Date, Number, Enum). Ensures data like dates or booleans aren't trapped as unparsable text." ;
    skos:inScheme ap:schema .

ap:assessmentId a owl:ObjectProperty ;
    rdfs:label "assessmentId" ;
    rdfs:range <https://ns.socialcaredata.io/person/Identifier> ;
    skos:definition "Assessment that led to this plan." ;
    skos:inScheme ap:schema .

ap:assessmentQuestion a owl:ObjectProperty ;
    rdfs:label "assessmentQuestion" ;
    rdfs:range ap:AssessmentQuestion ;
    skos:definition "The set of assessment questions and answers." ;
    skos:inScheme ap:schema .

ap:capacityToCompleteAssessment a owl:DatatypeProperty ;
    rdfs:label "capacityToCompleteAssessment" ;
    rdfs:range xsd:boolean ;
    skos:definition "Does the person have the mental and physical capacity to complete this assessment / plan?" ;
    skos:inScheme ap:schema .

ap:careComponent a owl:ObjectProperty ;
    rdfs:label "careComponent" ;
    rdfs:range ap:CareComponent ;
    skos:definition "Components of the care package." ;
    skos:inScheme ap:schema .

ap:category a owl:ObjectProperty ;
    rdfs:label "category" ;
    rdfs:range ap:question-category ;
    skos:definition "The domain/category of the question." ;
    skos:inScheme ap:schema .

ap:consentToInformationSharing a owl:DatatypeProperty ;
    rdfs:label "consentToInformationSharing" ;
    rdfs:range xsd:boolean ;
    skos:definition "Does the person consent to information sharing?" ;
    skos:inScheme ap:schema .

ap:dateCompleted a owl:DatatypeProperty ;
    rdfs:label "dateCompleted" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time that the assessment / plan was completed." ;
    skos:inScheme ap:schema .

ap:directPayment a owl:DatatypeProperty ;
    rdfs:label "directPayment" ;
    rdfs:range xsd:boolean ;
    skos:definition "Flag whether this component is paid via direct payment." ;
    skos:inScheme ap:schema .

ap:endDateTime a owl:DatatypeProperty ;
    rdfs:label "endDateTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The last date the component of the plan was performed before cancellation." ;
    skos:inScheme ap:schema .

ap:frequency a owl:DatatypeProperty ;
    rdfs:label "frequency" ;
    rdfs:range xsd:string ;
    skos:definition "The frequency the component of the plan is performed, expressed using FHIR Timing or similar." ;
    skos:inScheme ap:schema .

ap:isReview a owl:DatatypeProperty ;
    rdfs:label "isReview" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether this is a review of a previous assessment / plan or not." ;
    skos:inScheme ap:schema .

ap:outcome a owl:ObjectProperty ;
    rdfs:label "outcome" ;
    rdfs:range ap:care-act-outcome ;
    skos:definition "Care Act outcome that this care component is aiming to help the subject person achieve." ;
    skos:inScheme ap:schema .

ap:personId a owl:ObjectProperty ;
    rdfs:label "personId" ;
    rdfs:range <https://ns.socialcaredata.io/person/Identifier> ;
    skos:definition "Identifier for the subject person." ;
    skos:inScheme ap:schema .

ap:planId a owl:ObjectProperty ;
    rdfs:label "planId" ;
    rdfs:range <https://ns.socialcaredata.io/person/Identifier> ;
    skos:definition "Any care plan linked to this assessment. Quick signpost that a) a plan was made (ie the person was determined to be eligible) and b) where the plan is (so you don't need to search for it)." ;
    skos:inScheme ap:schema .

ap:professionalId a owl:ObjectProperty ;
    rdfs:label "professionalId" ;
    rdfs:range <https://ns.socialcaredata.io/person/Identifier> ;
    skos:definition "Identifier for the professional that authored the assessment/plan. Note that we don't need a serviceID, because you can find the service through the professional." ;
    skos:inScheme ap:schema .

ap:questionId a owl:DatatypeProperty ;
    rdfs:label "questionId" ;
    rdfs:range xsd:string ;
    skos:definition "An ID for the question. For statutory questions, this should conform to the dictionary of statutory question IDs; for personalised, non statutory questions, this can be anything or left blank." ;
    skos:inScheme ap:schema .

ap:questionText a owl:DatatypeProperty ;
    rdfs:label "questionText" ;
    rdfs:range xsd:string ;
    skos:definition "The exact wording of the question as it appears on the local authority's form." ;
    skos:inScheme ap:schema .

ap:required a owl:DatatypeProperty ;
    rdfs:label "required" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether this question was mandatory on the local authority’s assessment. Should always be True for statutory fields." ;
    skos:inScheme ap:schema .

ap:review a owl:ObjectProperty ;
    rdfs:label "review" ;
    rdfs:range ap:Review ;
    skos:definition "List of reviews." ;
    skos:inScheme ap:schema .

ap:startDateTime a owl:DatatypeProperty ;
    rdfs:label "startDateTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The first date the component of the plan was (scheduled to be) performed." ;
    skos:inScheme ap:schema .

ap:system a owl:DatatypeProperty ;
    rdfs:label "system" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The URI of the system or namespace within which the identifier is unique." ;
    skos:inScheme ap:schema .

ap:time a owl:ObjectProperty ;
    rdfs:label "time" ;
    rdfs:range ap:CareTiming ;
    skos:definition "The schedule and timing information of this component of the plan." ;
    skos:inScheme ap:schema .

ap:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range xsd:string ;
    skos:definition "The identifier value, unique within the issuing system." ;
    skos:inScheme ap:schema .

<https://ns.socialcaredata.io/person/Person> a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/aboutMe> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/isDeceased> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/sexCode> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/dateOfBirth> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/ethnicityCode> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:identifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/genderCode> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/deceasedDate> ] ;
    skos:definition "The top-level record describing an individual. Consolidates the core identity attributes required to distinguish one person from another and to record relationships between individuals. This is the canonical base Person; the two conformance profiles tighten the cardinalities below." ;
    skos:exactMatch <https://ns.socialcaredata.io/person/Person> ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/UPRN> a owl:DatatypeProperty ;
    rdfs:label "UPRN" ;
    rdfs:range xsd:string ;
    skos:definition "Unique Property Reference Number of the address." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/USRN> a owl:DatatypeProperty ;
    rdfs:label "USRN" ;
    rdfs:range xsd:string ;
    skos:definition "Unique Street Reference Number of the address." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/aboutMe> a owl:ObjectProperty ;
    rdfs:label "aboutMe" ;
    rdfs:range <https://ns.socialcaredata.io/person/Identifier> ;
    skos:definition "A reference pointing to the person's self-reported \"About Me\" profile (an in-use standard across health and care allowing individuals to record their wants and needs). Uses the Identifier structure." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/addressUse> a owl:ObjectProperty ;
    rdfs:label "addressUse" ;
    dct:title "use" ;
    rdfs:range <https://ns.socialcaredata.io/person/address-use-code> ;
    skos:definition "How this address is used - home, work, temp, etc." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/city> a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:range xsd:string ;
    skos:definition "City, town, or village." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/communicationNeeds> a owl:DatatypeProperty ;
    rdfs:label "communicationNeeds" ;
    rdfs:range xsd:string ;
    skos:definition "Free-text describing professionally recorded communication needs or reasonable adjustments (e.g. BSL interpreter needed, uses communication board)." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/contactName> a owl:DatatypeProperty ;
    rdfs:label "contactName" ;
    dct:title "name" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the contact type (for example, \"Home\", \"Work\", \"Other\")." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/date> a owl:DatatypeProperty ;
    rdfs:label "date" ;
    rdfs:range xsd:date ;
    skos:definition "ISO 8601-formatted date (YYYY-MM-DD)." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/dateOfBirth> a owl:ObjectProperty ;
    rdfs:label "dateOfBirth" ;
    rdfs:range <https://ns.socialcaredata.io/person/PartialDate> ;
    skos:definition "The person's date of birth, with an optional accuracy indicator." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/deceasedDate> a owl:ObjectProperty ;
    rdfs:label "deceasedDate" ;
    rdfs:range <https://ns.socialcaredata.io/person/PartialDate> ;
    skos:definition "The person's date of death, with an optional accuracy indicator. isDeceased may be true without a known date." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/ethnicityCode> a owl:ObjectProperty ;
    rdfs:label "ethnicityCode" ;
    rdfs:range <https://ns.socialcaredata.io/person/ethnicity-code> ;
    skos:definition "The person's stated ethnicity, using the ONS 18+1 categories from the 2021 census. Statutorily required in adult social care; optional elsewhere." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/familyName> a owl:DatatypeProperty ;
    rdfs:label "familyName" ;
    rdfs:range xsd:string ;
    skos:definition "The surname or family name. Multi-valued to support compound or hyphenated family names recorded as separate parts." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/genderCode> a owl:ObjectProperty ;
    rdfs:label "genderCode" ;
    rdfs:range <https://ns.socialcaredata.io/person/gender-code> ;
    skos:definition "The person's stated gender." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/givenName> a owl:DatatypeProperty ;
    rdfs:label "givenName" ;
    rdfs:range xsd:string ;
    skos:definition "The first name and any middle names." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/isDeceased> a owl:DatatypeProperty ;
    rdfs:label "isDeceased" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the person is deceased." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/languageCode> a owl:DatatypeProperty ;
    rdfs:label "languageCode" ;
    rdfs:range xsd:string ;
    skos:definition "A code or name representing the language (e.g., 'en', 'eng', 'bsl', 'British Sign Language')." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/line1> a owl:DatatypeProperty ;
    rdfs:label "line1" ;
    rdfs:range xsd:string ;
    skos:definition "Street address (e.g. \"1 High Street\") or care-of line." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/line2> a owl:DatatypeProperty ;
    rdfs:label "line2" ;
    rdfs:range xsd:string ;
    skos:definition "Apartment, suite, unit, building, floor, etc." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/name> a owl:ObjectProperty ;
    rdfs:label "name" ;
    rdfs:range <https://ns.socialcaredata.io/person/Name> ;
    skos:definition "A name for the person, with a usage indicating its purpose (usual, maiden, nickname, etc.)." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/nameUse> a owl:ObjectProperty ;
    rdfs:label "nameUse" ;
    dct:title "use" ;
    rdfs:range <https://ns.socialcaredata.io/person/name-use-code> ;
    skos:definition "The purpose of this name instance - usual, official, former, etc." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/preferredName> a owl:DatatypeProperty ;
    rdfs:label "preferredName" ;
    rdfs:range xsd:string ;
    skos:definition "Any preferred given or middle name used by the person - for example, \"Joe\" where their legal first name is \"Joseph\"." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/proficiencyLevel> a owl:DatatypeProperty ;
    rdfs:label "proficiencyLevel" ;
    rdfs:range xsd:string ;
    skos:definition "The level of proficiency or fluency in the language (e.g., 'fluent', 'native', 'basic')." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/relationship> a owl:ObjectProperty ;
    rdfs:label "relationship" ;
    rdfs:range <https://ns.socialcaredata.io/person/person-relationship-code> ;
    skos:definition "One or more codes describing the kind of relationship." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/sexCode> a owl:ObjectProperty ;
    rdfs:label "sexCode" ;
    rdfs:range <https://ns.socialcaredata.io/person/phenotypic-sex-code> ;
    skos:definition "Observed phenotypic sex, where recorded." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

ap:AssessmentQuestion a owl:Class ;
    rdfs:label "AssessmentQuestion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:required ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:category ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:questionText ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ap:answer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ap:questionId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:answerType ] ;
    skos:definition "A generic Question-and-Answer model used to represent both statutory Care Act questions and local, personalised fields." ;
    skos:exactMatch ap:AssessmentQuestion ;
    skos:inScheme ap:schema .

ap:CareActivity a owl:Class ;
    rdfs:label "CareActivity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:activityDescription ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ap:outcome ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ap:directPayment ] ;
    skos:definition "The description and details of the care component activity." ;
    skos:exactMatch ap:CareActivity ;
    skos:inScheme ap:schema .

ap:CareActor a owl:Class ;
    rdfs:label "CareActor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:actorId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:actorType ] ;
    skos:definition "The actor performing a care component." ;
    skos:exactMatch ap:CareActor ;
    skos:inScheme ap:schema .

ap:CareComponent a owl:Class ;
    rdfs:label "CareComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ap:actor ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:activity ] ;
    skos:definition "A specific component of a Care Plan, capturing who does what, when, and to achieve which outcomes." ;
    skos:exactMatch ap:CareComponent ;
    skos:inScheme ap:schema .

ap:CareTiming a owl:Class ;
    rdfs:label "CareTiming" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:frequency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ap:endDateTime ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:startDateTime ] ;
    skos:definition "The schedule and timing information of a care component." ;
    skos:exactMatch ap:CareTiming ;
    skos:inScheme ap:schema .

ap:FoundationalInformation a owl:Class ;
    rdfs:label "FoundationalInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:consentToInformationSharing ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:dateCompleted ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ap:review ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:personId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:capacityToCompleteAssessment ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:professionalId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:advocateRequired ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:identifier ] ;
    skos:definition "Information that is relevant across both assessments and plans." ;
    skos:inScheme ap:schema .

ap:Review a owl:Class ;
    rdfs:label "Review" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:isReview ] ;
    skos:definition "Review information associated with an assessment or care plan." ;
    skos:exactMatch ap:Review ;
    skos:inScheme ap:schema .

