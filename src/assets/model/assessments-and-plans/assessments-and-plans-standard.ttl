<https://ns.socialcaredata.io/person/postcode> a owl:DatatypeProperty ;
    rdfs:label "postcode" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[A-Z]{1,2}[0-9][0-9A-Z]? ?[0-9][A-Z]{2}$" ] ) ] ) ] ;
    skos:definition "UK postcode in standard format (e.g. AB1 2CD)." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

ap:care-act-eligibility-status a owl:Class ;
    rdfs:label "CareActEligibilityStatus" ;
    dct:title "Care Act Eligibility Status" ;
    owl:unionOf ( es:eligible-needs-identified es:non-eligible-needs-identified es:no-needs-identified ) ;
    skos:definition "Vocabulary for Care Act 2014 eligibility assessment under CA-ELIGIBILITY-01." ;
    skos:inScheme ap:schema ;
    linkml:permissible_values es:eligible-needs-identified,
        es:no-needs-identified,
        es:non-eligible-needs-identified .

ap:identifier a owl:ObjectProperty ;
    rdfs:label "identifier" ;
    rdfs:range <https://ns.socialcaredata.io/person/Identifier> ;
    skos:definition "Identifier for this assessment / plan." ;
    skos:inScheme ap:schema .

<https://ns.socialcaredata.io/person/PartialDate> a owl:Class ;
    rdfs:label "PartialDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[AEU]{3}$" ] ) ] ) ] ;
            owl:onProperty <https://ns.socialcaredata.io/person/accuracyIndicator> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/date> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/accuracyIndicator> ] ;
    skos:definition "Container for a date that may not be fully known or precise, extended with an accuracy indicator. Used for dates of birth and dates of death." ;
    skos:exactMatch <https://ns.socialcaredata.io/person/PartialDate> ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

