<https://ns.socialcaredata.io/person/Address> a owl:Class ;
    rdfs:label "Address" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/UPRN> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/postcode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Z]{1,2}[0-9][0-9A-Z]? ?[0-9][A-Z]{2}$" ] ) ] ) ] ;
            owl:onProperty <https://ns.socialcaredata.io/person/postcode> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/USRN> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/line1> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/line2> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/addressUse> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/city> ] ;
    skos:definition "A postal address for the person. Aligned with FHIR Address. UPRN and USRN support property- and street-level disambiguation." ;
    skos:exactMatch <https://ns.socialcaredata.io/person/Address> ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/Communication> a owl:Class ;
    rdfs:label "Communication" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/communicationNeeds> ] ;
    skos:definition "Professional recording of a person's communication requirements and language proficiencies." ;
    skos:exactMatch <https://ns.socialcaredata.io/person/Communication> ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/Contact> a owl:Class ;
    rdfs:label "Contact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/contactName> ] ;
    skos:definition "Contact details for a person, such as a home, work, or other contact channel grouping." ;
    skos:exactMatch <https://ns.socialcaredata.io/person/Contact> ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/Language> a owl:Class ;
    rdfs:label "Language" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/languageCode> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/proficiencyLevel> ] ;
    skos:definition "A specific language the person is proficient in, including proficiency level." ;
    skos:exactMatch <https://ns.socialcaredata.io/person/Language> ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/Name> a owl:Class ;
    rdfs:label "Name" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/familyName> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/nameUse> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/givenName> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/preferredName> ] ;
    skos:definition "Container for a person's name parts, aligned with FHIR HumanName. A person may have multiple names with different uses." ;
    skos:exactMatch <https://ns.socialcaredata.io/person/Name> ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/PersonRelationship> a owl:Class ;
    rdfs:label "PersonRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty ap:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://ns.socialcaredata.io/person/relationship> ] ;
    skos:definition "A typed reference from one person to another. The reference is by Identifier (so the related person may live in a different system) and is qualified by one or more relationship codes." ;
    skos:exactMatch <https://ns.socialcaredata.io/person/PersonRelationship> ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/accuracyIndicator> a owl:DatatypeProperty ;
    rdfs:label "accuracyIndicator" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[AEU]{3}$" ] ) ] ) ] ;
    skos:definition "A three-character code in day-month-year order indicating which parts of the date are accurate (A), estimated (E), or unknown (U)." ;
    skos:inScheme <https://ns.socialcaredata.io/person/schema> .

<https://ns.socialcaredata.io/person/address-use-code#Billing> a owl:Class ;
    rdfs:label "billing" ;
