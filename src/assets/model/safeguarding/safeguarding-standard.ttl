@prefix dct: <http://purl.org/dc/terms/> .
@prefix eo: <https://ns.socialcaredata.io/safeguarding/episode-outcome#> .
@prefix epc: <https://ns.socialcaredata.io/safeguarding/episode-code#> .
@prefix evc: <https://ns.socialcaredata.io/safeguarding/event-code#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix mt: <https://ns.socialcaredata.io/safeguarding/measurement-type#> .
@prefix mu: <https://ns.socialcaredata.io/safeguarding/measurement-unit#> .
@prefix oc: <https://ns.socialcaredata.io/safeguarding/organisation-code#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p: <https://ns.socialcaredata.io/person/> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix scf: <https://ns.socialcaredata.io/safeguarding/service-cost-frequency#> .
@prefix sd: <https://ns.socialcaredata.io/safeguarding/service-delivery#> .
@prefix sg: <https://ns.socialcaredata.io/safeguarding/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix svc: <https://ns.socialcaredata.io/safeguarding/service-code#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sg:alias a owl:DatatypeProperty ;
    rdfs:label "alias" ;
    rdfs:range xsd:string ;
    skos:definition "Other names the entity is known by." ;
    skos:inScheme sg:schema .

sg:dayOfWeek a owl:DatatypeProperty ;
    rdfs:label "dayOfWeek" ;
    rdfs:range xsd:string ;
    skos:definition "Days of the week the event recurs on (mon..sun)." ;
    skos:inScheme sg:schema .

sg:delivery a owl:ObjectProperty ;
    rdfs:label "delivery" ;
    rdfs:range sg:service-delivery ;
    skos:definition "The way the service is delivered." ;
    skos:inScheme sg:schema .

sg:finding a owl:ObjectProperty ;
    rdfs:label "finding" ;
    rdfs:range sg:Finding ;
    skos:definition "Observations or measurements made during the course of the episode." ;
    skos:inScheme sg:schema .

sg:measurement a owl:ObjectProperty ;
    rdfs:label "measurement" ;
    rdfs:range sg:Measurement ;
    skos:definition "Quantitative measurement(s) about the subject or their circumstances." ;
    skos:inScheme sg:schema .

sg:observation a owl:ObjectProperty ;
    rdfs:label "observation" ;
    rdfs:range sg:Observation ;
    skos:definition "Qualitative observation(s) about the subject or their circumstances." ;
    skos:inScheme sg:schema .

sg:relatedOrganisationRef a owl:ObjectProperty ;
    rdfs:label "relatedOrganisationRef" ;
    dct:title "relatedOrganisation" ;
    rdfs:range p:Identifier ;
    skos:definition "References (by Identifier) to Organisations associated with the entity." ;
    skos:inScheme sg:schema .

sg:relatedProfessionalObj a owl:ObjectProperty ;
    rdfs:label "relatedProfessionalObj" ;
    dct:title "relatedProfessional" ;
    rdfs:range sg:RelatedProfessional ;
    skos:definition "References to the Professional(s) involved, qualified by involvement." ;
    skos:inScheme sg:schema .

sg:relatedProfessionalRef a owl:ObjectProperty ;
    rdfs:label "relatedProfessionalRef" ;
    dct:title "relatedProfessional" ;
    rdfs:range p:Identifier ;
    skos:definition "References (by Identifier) to Professionals associated with the entity." ;
    skos:inScheme sg:schema .

sg:schema.owl.ttl a owl:Ontology ;
    rdfs:label "safeguarding" ;
    dct:license "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" ;
    dct:title "Safeguarding Standard Data Model" ;
    pav:version "1.0.0" ;
    owl:imports p:schema ;
    skos:definition """A LinkML data model for the Safeguarding Standard: a common data model for recording the services, professionals, organisations, service episodes and life events involved in safeguarding and promoting the wellbeing of a person, to support multi-agency information sharing (MAIS).
The model is organised around five top-level entities - Organisation, Service, Professional, ServiceEpisode and LifeEvent - and the shared objects that link them together (Identifier, Name, Address, Contact). The shared objects are defined once by the Person Standard and imported from person-standard.yaml, so this schema reuses their p: ontology IRIs (p:Identifier, p:Name, p:Address, p:Contact) rather than redefining them. Coded fields draw their values from the controlled vocabularies (enums) declared below.""" .

sg:sgAddress a owl:ObjectProperty ;
    rdfs:label "sgAddress" ;
    dct:title "address" ;
    rdfs:range p:Address ;
    skos:definition "Physical location(s) of the entity." ;
    skos:inScheme sg:schema .

sg:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    rdfs:range xsd:string ;
    skos:definition "A finding that cannot be represented as an Observation or Measurement." ;
    skos:inScheme sg:schema .

sg:timeOfDay a owl:DatatypeProperty ;
    rdfs:label "timeOfDay" ;
    rdfs:range xsd:string ;
    skos:definition "Time(s) of day the event occurs (hh:mm:ss)." ;
    skos:inScheme sg:schema .

sg:whenCode a owl:DatatypeProperty ;
    rdfs:label "whenCode" ;
    dct:title "when" ;
    rdfs:range xsd:string ;
    skos:definition "Event-related timing(s), e.g. MORN for the morning." ;
    skos:inScheme sg:schema .

sg:LifeEvent a owl:Class ;
    rdfs:label "LifeEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:subjectPerson ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:sgIdentifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:eventType ] ;
    skos:definition "A significant, time-bound occurrence in an individual's life that may have implications for their safety, wellbeing or development - for example attendance at A&E, a child being reported as missing, or an exclusion from school. Life events are not inherently positive or negative but can signal levels of risk, vulnerability or changing need." ;
    skos:exactMatch sg:LifeEvent ;
    skos:inScheme sg:schema .

sg:Organisation a owl:Class ;
    rdfs:label "Organisation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:contactMulti ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:relatedServiceRef ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:sgIdentifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:entityName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:active ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:organisationType ] ;
    skos:definition "An organisation involved in the safeguarding or wellbeing of a person - for example a local authority, an NHS trust, a school, or an education authority. Aligns with the FHIR Organization resource." ;
    skos:exactMatch sg:Organisation ;
    skos:inScheme sg:schema .

sg:Professional a owl:Class ;
    rdfs:label "Professional" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:professionalName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:status ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:contactSingle ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:sgIdentifier ] ;
    skos:definition "An individual acting in a formal role within an organisation who has responsibilities relating to a person's safety, wellbeing, care or support - for example undertaking assessments, creating and monitoring plans, or sharing information in a multi-agency context." ;
    skos:exactMatch sg:Professional ;
    skos:inScheme sg:schema .

sg:Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:entityName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:serviceType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:contactMulti ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:active ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:costFrequency ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:sgIdentifier ] ;
    skos:definition "A service involved in the safeguarding or wellbeing of a person - the specific intervention or package of support delivered by one or more organisations (e.g. local authority social care, an emergency department, a general practice, or a school)." ;
    skos:exactMatch sg:Service ;
    skos:inScheme sg:schema .

sg:ServiceEpisode a owl:Class ;
    rdfs:label "ServiceEpisode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:outcome ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:relatedServiceRef ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:sgIdentifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:episodeType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:location ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:timeInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:subjectPerson ] ;
    skos:definition "A bounded period during which an individual receives a defined service, intervention, or package of support from a service or professional. It has a recognisable start and end point, though duration may vary from a single contact to sustained involvement over time." ;
    skos:exactMatch sg:ServiceEpisode ;
    skos:inScheme sg:schema .

sg:contactSingle a owl:ObjectProperty ;
    rdfs:label "contactSingle" ;
    dct:title "contact" ;
    rdfs:range p:Contact ;
    skos:definition "The professional's contact information (exactly one)." ;
    skos:inScheme sg:schema .

sg:costFrequency a owl:ObjectProperty ;
    rdfs:label "costFrequency" ;
    rdfs:range sg:service-cost-frequency ;
    skos:definition "The frequency at which the unit cost occurs." ;
    skos:inScheme sg:schema .

sg:endDateTime a owl:DatatypeProperty ;
    rdfs:label "endDateTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The end of the episode or life event, as an ISO 8601 date-time." ;
    skos:inScheme sg:schema .

sg:episodeType a owl:ObjectProperty ;
    rdfs:label "episodeType" ;
    dct:title "type" ;
    rdfs:range sg:episode-code ;
    skos:definition "Code(s) for the type of service episode." ;
    skos:inScheme sg:schema .

sg:eventType a owl:ObjectProperty ;
    rdfs:label "eventType" ;
    dct:title "type" ;
    rdfs:range sg:event-code ;
    skos:definition "Code(s) for the type of life event." ;
    skos:inScheme sg:schema .

sg:frequency a owl:ObjectProperty ;
    rdfs:label "frequency" ;
    rdfs:range sg:Timing ;
    skos:definition "The frequency of the episode or life event, expressed as a FHIR Timing." ;
    skos:inScheme sg:schema .

sg:location a owl:DatatypeProperty ;
    rdfs:label "location" ;
    rdfs:range xsd:string ;
    skos:definition "Details about the location of the episode or life event." ;
    skos:inScheme sg:schema .

sg:measurementType a owl:ObjectProperty ;
    rdfs:label "measurementType" ;
    dct:title "type" ;
    rdfs:range sg:measurement-type ;
    skos:definition "The type of measurement." ;
    skos:inScheme sg:schema .

sg:measurementUnit a owl:ObjectProperty ;
    rdfs:label "measurementUnit" ;
    dct:title "unit" ;
    rdfs:range sg:measurement-unit ;
    skos:definition "The unit of measurement." ;
    skos:inScheme sg:schema .

sg:measurementValue a owl:DatatypeProperty ;
    rdfs:label "measurementValue" ;
    dct:title "value" ;
    rdfs:range xsd:decimal ;
    skos:definition "A decimal number representing the value of the measurement." ;
    skos:inScheme sg:schema .

sg:observationEndDate a owl:DatatypeProperty ;
    rdfs:label "observationEndDate" ;
    dct:title "endDate" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date at which this observation was made false (if now outdated)." ;
    skos:inScheme sg:schema .

sg:observationStartDate a owl:DatatypeProperty ;
    rdfs:label "observationStartDate" ;
    dct:title "startDate" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date at which this observation was first true, as an ISO 8601 date-time." ;
    skos:inScheme sg:schema .

sg:observationType a owl:DatatypeProperty ;
    rdfs:label "observationType" ;
    dct:title "type" ;
    rdfs:range xsd:string ;
    skos:definition "The type of observation, drawn from the Observation Type Vocabulary (e.g. NEET, free-school-meals, SEND.SpLD). The vocabulary is extensible (some codes carry dynamic sub-parts such as EAL.<ISO 639-1>), so it is modelled as an open string rather than a closed enumeration." ;
    skos:inScheme sg:schema .

sg:organisationType a owl:ObjectProperty ;
    rdfs:label "organisationType" ;
    dct:title "type" ;
    rdfs:range sg:organisation-code ;
    skos:definition "Code(s) for the kind of organisation." ;
    skos:inScheme sg:schema .

sg:outcome a owl:ObjectProperty ;
    rdfs:label "outcome" ;
    rdfs:range sg:episode-outcome ;
    skos:definition "Outcome of the episode for the subject." ;
    skos:inScheme sg:schema .

sg:period a owl:DatatypeProperty ;
    rdfs:label "period" ;
    rdfs:range xsd:integer ;
    skos:definition "The length of the recurrence period." ;
    skos:inScheme sg:schema .

sg:periodUnit a owl:DatatypeProperty ;
    rdfs:label "periodUnit" ;
    rdfs:range xsd:string ;
    skos:definition "The unit of the recurrence period (s, min, h, d, wk, mo, a)." ;
    skos:inScheme sg:schema .

sg:person a owl:ObjectProperty ;
    rdfs:label "person" ;
    rdfs:range p:Identifier ;
    skos:definition "A reference (by Identifier) to a Person record involved in the episode or life event." ;
    skos:inScheme sg:schema .

sg:professional a owl:ObjectProperty ;
    rdfs:label "professional" ;
    rdfs:range p:Identifier ;
    skos:definition "A reference (by Identifier) to a Professional record involved in the episode or life event." ;
    skos:inScheme sg:schema .

sg:professionalName a owl:ObjectProperty ;
    rdfs:label "professionalName" ;
    dct:title "name" ;
    rdfs:range p:Name ;
    skos:definition "The professional's name." ;
    skos:inScheme sg:schema .

sg:repeat a owl:ObjectProperty ;
    rdfs:label "repeat" ;
    rdfs:range sg:Repeat ;
    skos:definition "The FHIR Timing repeat structure." ;
    skos:inScheme sg:schema .

sg:repeatFrequency a owl:DatatypeProperty ;
    rdfs:label "repeatFrequency" ;
    dct:title "frequency" ;
    rdfs:range xsd:integer ;
    skos:definition "The number of times the event occurs per period." ;
    skos:inScheme sg:schema .

sg:role a owl:DatatypeProperty ;
    rdfs:label "role" ;
    rdfs:range xsd:string ;
    skos:definition "Text describing the professional's occupational role." ;
    skos:inScheme sg:schema .

sg:serviceType a owl:ObjectProperty ;
    rdfs:label "serviceType" ;
    dct:title "type" ;
    rdfs:range sg:service-code ;
    skos:definition "Code(s) for the kind of service." ;
    skos:inScheme sg:schema .

sg:startDateTime a owl:DatatypeProperty ;
    rdfs:label "startDateTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The start of the episode or life event, as an ISO 8601 date-time." ;
    skos:inScheme sg:schema .

sg:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:range xsd:boolean ;
    skos:definition "The professional's current working status." ;
    skos:inScheme sg:schema .

sg:timeInformation a owl:ObjectProperty ;
    rdfs:label "timeInformation" ;
    rdfs:range sg:TimeInformation ;
    skos:definition "Details about the timing of the episode or life event." ;
    skos:inScheme sg:schema .

sg:Finding a owl:Class ;
    rdfs:label "Finding" ;
    skos:definition "An observation or measurement made during the course of a service episode about the subject and their circumstances. May be recorded as a structured Observation, a quantitative Measurement, and/or free text." ;
    skos:exactMatch sg:Finding ;
    skos:inScheme sg:schema .

sg:Measurement a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:measurementType ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:measurementUnit ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:measurementValue ] ;
    skos:definition "A quantitative measurement of something related to the subject or their circumstances (for example \"Authorised Absences\" or \"Referrals\")." ;
    skos:exactMatch sg:Measurement ;
    skos:inScheme sg:schema .

sg:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:observationStartDate ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:observationType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:observationEndDate ] ;
    skos:definition "A qualitative observation that represents an attribute of the subject or their circumstances (for example \"NEET\" or \"free-school-meals\")." ;
    skos:exactMatch sg:Observation ;
    skos:inScheme sg:schema .

sg:RelatedProfessional a owl:Class ;
    rdfs:label "RelatedProfessional" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:involvement ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:professional ] ;
    skos:definition "A typed reference to a Professional involved in a service episode or life event." ;
    skos:exactMatch sg:RelatedProfessional ;
    skos:inScheme sg:schema .

sg:Repeat a owl:Class ;
    rdfs:label "Repeat" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:period ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:periodUnit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:repeatFrequency ] ;
    skos:definition "The nested repeat structure of a FHIR Timing, describing how often an event recurs. All fields are optional; the shape is non-closed so any additional FHIR repeat field is permitted." ;
    skos:exactMatch sg:Repeat ;
    skos:inScheme sg:schema .

sg:SubjectPerson a owl:Class ;
    rdfs:label "SubjectPerson" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:involvement ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:person ] ;
    skos:definition "A typed reference to a Person involved in a service episode or life event." ;
    skos:exactMatch sg:SubjectPerson ;
    skos:inScheme sg:schema .

sg:TimeInformation a owl:Class ;
    rdfs:label "TimeInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:endDateTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:frequency ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:startDateTime ] ;
    skos:definition "Details about the timing of a service episode or life event, including when it started and ended and how frequently it recurs." ;
    skos:exactMatch sg:TimeInformation ;
    skos:inScheme sg:schema .

sg:Timing a owl:Class ;
    rdfs:label "Timing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:repeat ] ;
    skos:definition "A recurring schedule, expressed as (a subset of) the FHIR Timing datatype. Not defined by this standard - see the FHIR Timing documentation for the full set of fields. Modelled openly (non-closed) here." ;
    skos:exactMatch sg:Timing ;
    skos:inScheme sg:schema .

sg:active a owl:DatatypeProperty ;
    rdfs:label "active" ;
    rdfs:range xsd:boolean ;
    skos:definition "Code for the entity's status - whether it is currently active." ;
    skos:inScheme sg:schema .

sg:contactMulti a owl:ObjectProperty ;
    rdfs:label "contactMulti" ;
    dct:title "contact" ;
    rdfs:range p:Contact ;
    skos:definition "Contact information (multi-valued)." ;
    skos:inScheme sg:schema .

sg:entityName a owl:DatatypeProperty ;
    rdfs:label "entityName" ;
    dct:title "name" ;
    rdfs:range xsd:string ;
    skos:definition "The official name of the organisation or service." ;
    skos:inScheme sg:schema .

epc:AdultSafeguarding a owl:Class ;
    rdfs:label "adult-safeguarding" ;
    dct:title "Adult Safeguarding Enquiry (Section 42)" ;
    rdfs:subClassOf sg:episode-code .

epc:CamhsPlan a owl:Class ;
    rdfs:label "CAMHS-plan" ;
    dct:title "Children and Adolescent mental health services care plan" ;
    rdfs:subClassOf sg:episode-code .

epc:CareLeaver a owl:Class ;
    rdfs:label "care-leaver" ;
    dct:title "Care Leaver Support" ;
    rdfs:subClassOf sg:episode-code .

epc:ChildLookedAfter a owl:Class ;
    rdfs:label "child-looked-after" ;
    dct:title "Child in LA care" ;
    rdfs:subClassOf sg:episode-code .

epc:CinPlan a owl:Class ;
    rdfs:label "cin-plan" ;
    dct:title "Child in Need (CIN) Plan" ;
    rdfs:subClassOf sg:episode-code .

epc:CpPlan a owl:Class ;
    rdfs:label "cp-plan" ;
    dct:title "Child Protection (CP) Plan" ;
    rdfs:subClassOf sg:episode-code .

epc:EarlyHelp a owl:Class ;
    rdfs:label "early-help" ;
    dct:title "Early Help Assessment / Intervention" ;
    rdfs:subClassOf sg:episode-code .

epc:Ehcp a owl:Class ;
    rdfs:label "ehcp" ;
    dct:title "Education, Health, and Care plan" ;
    rdfs:subClassOf sg:episode-code .

epc:FamilyCourtOrder a owl:Class ;
    rdfs:label "family-court-order" ;
    dct:title "Any order made by family court" ;
    rdfs:subClassOf sg:episode-code .

epc:Section47 a owl:Class ;
    rdfs:label "section-47" ;
    dct:title "Section 47 Enquiry" ;
    rdfs:subClassOf sg:episode-code .

eo:Assessment a owl:Class ;
    rdfs:label "assessment" ;
    dct:title "Progress to assessment, review, or reassessment" ;
    rdfs:subClassOf sg:episode-outcome .

eo:Continuation a owl:Class ;
    rdfs:label "continuation" ;
    dct:title "Continuation of support or services" ;
    rdfs:subClassOf sg:episode-outcome .

eo:Hospital a owl:Class ;
    rdfs:label "hospital" ;
    dct:title "Admitted to hospital" ;
    rdfs:subClassOf sg:episode-outcome .

eo:NfaDeceased a owl:Class ;
    rdfs:label "NFA-deceased" ;
    dct:title "No Further Action: Client deceased" ;
    rdfs:subClassOf sg:episode-outcome .

eo:NfaDeclined a owl:Class ;
    rdfs:label "NFA-declined" ;
    dct:title "No Further Action: Support declined" ;
    rdfs:subClassOf sg:episode-outcome .

eo:NfaDisregard a owl:Class ;
    rdfs:label "NFA-disregard" ;
    dct:title "No Further Action: Self-funded client or under 12 week property disregard" ;
    rdfs:subClassOf sg:episode-outcome .

eo:NfaEndedOther a owl:Class ;
    rdfs:label "NFA-ended-other" ;
    dct:title "No Further Action: Support ended for other reason" ;
    rdfs:subClassOf sg:episode-outcome .

eo:NfaInfo a owl:Class ;
    rdfs:label "NFA-info" ;
    dct:title "No Further Action: Information and advice or signposting" ;
    rdfs:subClassOf sg:episode-outcome .

eo:NfaLocalReferral a owl:Class ;
    rdfs:label "NFA-local-referral" ;
    dct:title "No Further Action: Referral to other service within the local authority" ;
    rdfs:subClassOf sg:episode-outcome .

eo:NfaMoved a owl:Class ;
    rdfs:label "NFA-moved" ;
    dct:title "No Further Action: Responsibility moved to another local authority" ;
    rdfs:subClassOf sg:episode-outcome .

