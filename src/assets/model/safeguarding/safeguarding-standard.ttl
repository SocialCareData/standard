p:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty p:system ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty p:value ] ;
    skos:definition "A single identifier for a person, comprising the value and the system in whose namespace the value is unique. Aligned with FHIR Identifier and the NHS PDS UNIQUE_REFERENCE definition." ;
    skos:exactMatch p:Identifier ;
    skos:inScheme p:schema .

sg:event-code a owl:Class ;
    rdfs:label "EventCode" ;
    dct:title "Event Code" ;
    owl:unionOf ( evc:Birth evc:Death evc:AeAttendance evc:SchoolExclusion evc:SchoolSuspension evc:MissingPerson evc:SafeguardingConcern evc:Referral evc:Homeless ) ;
