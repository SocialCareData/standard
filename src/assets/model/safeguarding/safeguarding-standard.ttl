p:postcode a owl:DatatypeProperty ;
    rdfs:label "postcode" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[A-Z]{1,2}[0-9][0-9A-Z]? ?[0-9][A-Z]{2}$" ] ) ] ) ] ;
    skos:definition "UK postcode in standard format (e.g. AB1 2CD)." ;
    skos:inScheme p:schema .

sg:Finding a owl:Class ;
    rdfs:label "Finding" ;
    skos:definition "An observation or measurement made during the course of a service episode about the subject and their circumstances. May be recorded as a structured Observation, a quantitative Measurement, and/or free text." ;
    skos:exactMatch sg:Finding ;
    skos:inScheme sg:schema .

sg:Measurement a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:measurementValue ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:measurementUnit ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:measurementType ] ;
    skos:definition "A quantitative measurement of something related to the subject or their circumstances (for example \"Authorised Absences\" or \"Referrals\")." ;
    skos:exactMatch sg:Measurement ;
    skos:inScheme sg:schema .

sg:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:observationEndDate ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:observationStartDate ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:observationType ] ;
    skos:definition "A qualitative observation that represents an attribute of the subject or their circumstances (for example \"NEET\" or \"free-school-meals\")." ;
    skos:exactMatch sg:Observation ;
    skos:inScheme sg:schema .

sg:RelatedProfessional a owl:Class ;
    rdfs:label "RelatedProfessional" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:professional ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:involvement ] ;
    skos:definition "A typed reference to a Professional involved in a service episode or life event." ;
    skos:exactMatch sg:RelatedProfessional ;
    skos:inScheme sg:schema .

sg:SubjectPerson a owl:Class ;
    rdfs:label "SubjectPerson" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:involvement ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:person ] ;
    skos:definition "A typed reference to a Person involved in a service episode or life event." ;
    skos:exactMatch sg:SubjectPerson ;
    skos:inScheme sg:schema .

sg:TimeInformation a owl:Class ;
    rdfs:label "TimeInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:endDateTime ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:startDateTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:frequency ] ;
    skos:definition "Details about the timing of a service episode or life event, including when it started and ended and how frequently it recurs." ;
    skos:exactMatch sg:TimeInformation ;
    skos:inScheme sg:schema .

sg:active a owl:DatatypeProperty ;
    rdfs:label "active" ;
    rdfs:range xsd:boolean ;
    skos:definition "Code for the entity's status - whether it is currently active." ;
    skos:inScheme sg:schema .

sg:contactMulti a owl:ObjectProperty ;
    rdfs:label "contactMulti" ;
    dct:title "contact" ;
    rdfs:range p:Contact ;
    skos:definition "Contact information (multi-valued)." ;
    skos:inScheme sg:schema .

sg:entityName a owl:DatatypeProperty ;
    rdfs:label "entityName" ;
    dct:title "name" ;
    rdfs:range xsd:string ;
    skos:definition "The official name of the organisation or service." ;
    skos:inScheme sg:schema .

