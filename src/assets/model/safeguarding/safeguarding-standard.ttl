sg:subjectPerson a owl:ObjectProperty ;
    rdfs:label "subjectPerson" ;
    rdfs:range sg:SubjectPerson ;
    skos:definition "References to the Person(s) the episode or life event concerns." ;
    skos:inScheme sg:schema .

p:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Z]{1,2}[0-9][0-9A-Z]? ?[0-9][A-Z]{2}$" ] ) ] ) ] ;
            owl:onProperty p:postcode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:line2 ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty p:city ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:USRN ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty p:postcode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:UPRN ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:addressUse ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty p:line1 ] ;
    skos:definition "A postal address for the person. Aligned with FHIR Address. UPRN and USRN support property- and street-level disambiguation." ;
    skos:exactMatch p:Address ;
    skos:inScheme p:schema .

p:Name a owl:Class ;
    rdfs:label "Name" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:nameUse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:preferredName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty p:familyName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty p:givenName ] ;
    skos:definition "Container for a person's name parts, aligned with FHIR HumanName. A person may have multiple names with different uses." ;
    skos:exactMatch p:Name ;
    skos:inScheme p:schema .

p:PartialDate a owl:Class ;
    rdfs:label "PartialDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[AEU]{3}$" ] ) ] ) ] ;
            owl:onProperty p:accuracyIndicator ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty p:date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:accuracyIndicator ] ;
    skos:definition "Container for a date that may not be fully known or precise, extended with an accuracy indicator. Used for dates of birth and dates of death." ;
    skos:exactMatch p:PartialDate ;
    skos:inScheme p:schema .

sg:measurement-unit a owl:Class ;
    rdfs:label "MeasurementUnit" ;
    dct:title "Measurement Unit" ;
    owl:unionOf ( mu:Count mu:Pct ) ;
    skos:definition "Codes to indicate the unit of measurement." ;
    skos:inScheme sg:schema ;
    linkml:permissible_values mu:Count,
        mu:Pct .

p:Contact a owl:Class ;
    rdfs:label "Contact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:contactName ] ;
    skos:definition "Contact details for a person, such as a home, work, or other contact channel grouping." ;
    skos:exactMatch p:Contact ;
    skos:inScheme p:schema .

sg:organisation-code a owl:Class ;
    rdfs:label "OrganisationCode" ;
    dct:title "Organisation Code" ;
    owl:unionOf ( oc:LocalAuthority oc:NhsTrust oc:PoliceForce ) ;
    skos:definition "Codes to indicate the type of organisation." ;
    skos:inScheme sg:schema ;
    linkml:permissible_values oc:LocalAuthority,
        oc:NhsTrust,
        oc:PoliceForce .

p:gender-code a owl:Class ;
    rdfs:label "GenderCode" ;
    dct:title "Gender Code" ;
    owl:unionOf ( <https://ns.socialcaredata.io/person/gender-code#Male> <https://ns.socialcaredata.io/person/gender-code#Female> <https://ns.socialcaredata.io/person/gender-code#Indeterminate> <https://ns.socialcaredata.io/person/gender-code#NotKnown> ) ;
    skos:definition "A person's stated gender identity, as distinct from biological sex. Aligned with NHS PERSON_STATED_GENDER_CODE." ;
    skos:inScheme p:schema ;
    linkml:permissible_values <https://ns.socialcaredata.io/person/gender-code#Female>,
        <https://ns.socialcaredata.io/person/gender-code#Indeterminate>,
        <https://ns.socialcaredata.io/person/gender-code#Male>,
        <https://ns.socialcaredata.io/person/gender-code#NotKnown> .

p:phenotypic-sex-code a owl:Class ;
    rdfs:label "PhenotypicSexCode" ;
    dct:title "Phenotypic Sex Code" ;
    owl:unionOf ( <https://ns.socialcaredata.io/person/phenotypic-sex-code#Male> <https://ns.socialcaredata.io/person/phenotypic-sex-code#Female> <https://ns.socialcaredata.io/person/phenotypic-sex-code#Indeterminate> <https://ns.socialcaredata.io/person/phenotypic-sex-code#NotKnown> ) ;
    skos:definition "Observed phenotypic sex where recorded, representing biological characteristics rather than gender identity. Aligned with NHS PDS PERSON_PHENOTYPIC_SEX." ;
    skos:inScheme p:schema ;
    linkml:permissible_values <https://ns.socialcaredata.io/person/phenotypic-sex-code#Female>,
        <https://ns.socialcaredata.io/person/phenotypic-sex-code#Indeterminate>,
        <https://ns.socialcaredata.io/person/phenotypic-sex-code#Male>,
        <https://ns.socialcaredata.io/person/phenotypic-sex-code#NotKnown> .

sg:measurement-type a owl:Class ;
    rdfs:label "MeasurementType" ;
    dct:title "Measurement Type" ;
    owl:unionOf ( mt:Attendance mt:AuthorisedAbsences mt:UnauthorisedAbsences mt:CaringHoursPerWeek ) ;
    skos:definition "Codes to indicate the type of measurement." ;
    skos:inScheme sg:schema ;
    linkml:permissible_values mt:Attendance,
        mt:AuthorisedAbsences,
        mt:CaringHoursPerWeek,
        mt:UnauthorisedAbsences .

sg:sgIdentifier a owl:ObjectProperty ;
    rdfs:label "sgIdentifier" ;
    dct:title "identifier" ;
    rdfs:range p:Identifier ;
    skos:definition "Unique identifiers associated with the entity." ;
    skos:inScheme sg:schema .

p:address-use-code a owl:Class ;
    rdfs:label "AddressUseCode" ;
    dct:title "Address Use Code" ;
    owl:unionOf ( <https://ns.socialcaredata.io/person/address-use-code#Home> <https://ns.socialcaredata.io/person/address-use-code#Work> <https://ns.socialcaredata.io/person/address-use-code#Temp> <https://ns.socialcaredata.io/person/address-use-code#Old> <https://ns.socialcaredata.io/person/address-use-code#Billing> ) ;
    skos:definition "How an address is used. Aligned with the FHIR address-use value set." ;
    skos:inScheme p:schema ;
    linkml:permissible_values <https://ns.socialcaredata.io/person/address-use-code#Billing>,
        <https://ns.socialcaredata.io/person/address-use-code#Home>,
        <https://ns.socialcaredata.io/person/address-use-code#Old>,
        <https://ns.socialcaredata.io/person/address-use-code#Temp>,
        <https://ns.socialcaredata.io/person/address-use-code#Work> .

p:name-use-code a owl:Class ;
    rdfs:label "NameUseCode" ;
    dct:title "Name Use Code" ;
