ot:Send a owl:Class ;
    rdfs:label "SEND" ;
    dct:title "SEND" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Observed special educational needs and disabilities, via DfE codes" .

ot:SendAsc a owl:Class ;
    rdfs:label "SEND.ASC" ;
    dct:title "SEND ASC" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Autistic Spectrum Condition: including Asperger's Syndrome and Autism with associated difficulties such as difficulties with language, communication, imagination and social interactions." .

ot:SendDs a owl:Class ;
    rdfs:label "SEND.DS" ;
    dct:title "SEND DS" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Down Syndrome: a genetic disorder caused by the presence of all or part of a third copy of chromosome 21." .

ot:SendHi a owl:Class ;
    rdfs:label "SEND.HI" ;
    dct:title "SEND HI" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Hearing Impairment: With a degree of hearing loss." .

ot:SendMld a owl:Class ;
    rdfs:label "SEND.MLD" ;
    dct:title "SEND MLD" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Moderate Learning Difficulty: well below expected levels of attainment in all or most areas of the curriculum, despite appropriate interventions. They will have much greater difficulty than their peers in acquiring basic literacy and numeracy skills and in understanding concepts. They may also have associated speech and language delay, low self-esteem, low levels of concentration and underdeveloped social skills." .

ot:SendMsi a owl:Class ;
    rdfs:label "SEND.MSI" ;
    dct:title "SEND MSI" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Multi Sensory Impairment: combined vision and hearing impairments." .

ot:SendNsa a owl:Class ;
    rdfs:label "SEND.NSA" ;
    dct:title "SEND NSA" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "NSA SEN support but no specialist assessment of type of need." .

ot:SendOth a owl:Class ;
    rdfs:label "SEND.OTH" ;
    dct:title "SEND OTH" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Other SEND: any other special educational need or disability not covered by the other codes." .

ot:SendPd a owl:Class ;
    rdfs:label "SEND.PD" ;
    dct:title "SEND PD" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Physical Disability: limitation on a person's physical functioning, mobility, dexterity or stamina." .

ot:SendPmld a owl:Class ;
    rdfs:label "SEND.PMLD" ;
    dct:title "SEND PMLD" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Profound and Multiple Learning Difficulty: have severe and complex learning difficulties as well as a physical disability or sensory impairment." .

ot:SendSemh a owl:Class ;
    rdfs:label "SEND.SEMH" ;
    dct:title "SEND SEMH" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Social, Emotional and Mental Health difficulties: These may include becoming withdrawn or isolated, as well as displaying challenging, disruptive or disturbing behaviour. These behaviours may reflect underlying mental health difficulties such as anxiety or depression, self-harming, substance misuse, eating disorders or physical symptoms that are medically unexplained." .

ot:SendSlcn a owl:Class ;
    rdfs:label "SEND.SLCN" ;
    dct:title "SEND SLCN" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Speech, Language and Communication Needs: difficulty in communicating with others such as difficulty saying what they want to, understanding what is being said to them, difficulties understanding and applying social rules." .

ot:SendSld a owl:Class ;
    rdfs:label "SEND.SLD" ;
    dct:title "SEND SLD" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Severe Learning Difficulty: significant intellectual or cognitive impairments and are likely to need support in all areas of the curriculum." .

ot:SendSpld a owl:Class ;
    rdfs:label "SEND.SpLD" ;
    dct:title "SEND SpLD" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Specific learning Difficulty: difficulty that affect one or more specific aspects of learning. This encompasses a range of conditions including dyslexia, dyscalculia, dysgraphia, dyspraxia etc." .

ot:SendVi a owl:Class ;
    rdfs:label "SEND.VI" ;
    dct:title "SEND VI" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Visual Impairment: Partial or complete loss of sight not correctable by usual means (e.g. prescribed glasses or contact lens)." .

