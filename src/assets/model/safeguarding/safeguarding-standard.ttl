@prefix dct: <http://purl.org/dc/terms/> .
@prefix eo: <https://ns.socialcaredata.io/safeguarding/episode-outcome#> .
@prefix epc: <https://ns.socialcaredata.io/safeguarding/episode-code#> .
@prefix evc: <https://ns.socialcaredata.io/safeguarding/event-code#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix mt: <https://ns.socialcaredata.io/safeguarding/measurement-type#> .
@prefix mu: <https://ns.socialcaredata.io/safeguarding/measurement-unit#> .
@prefix oc: <https://ns.socialcaredata.io/safeguarding/organisation-code#> .
@prefix ot: <https://ns.socialcaredata.io/safeguarding/observation-type#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p: <https://ns.socialcaredata.io/person/> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix scf: <https://ns.socialcaredata.io/safeguarding/service-cost-frequency#> .
@prefix sd: <https://ns.socialcaredata.io/safeguarding/service-delivery#> .
@prefix sg: <https://ns.socialcaredata.io/safeguarding/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix svc: <https://ns.socialcaredata.io/safeguarding/service-code#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

p:address a owl:ObjectProperty ;
    rdfs:label "address" ;
    rdfs:range p:Address ;
    skos:definition "Physical addresses where the person can be contacted." ;
    skos:inScheme p:schema .

p:contact a owl:ObjectProperty ;
    rdfs:label "contact" ;
    rdfs:range p:Contact ;
    skos:definition "The person's contact information." ;
    skos:inScheme p:schema .

p:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:range xsd:string ;
    skos:definition "One or more email addresses." ;
    skos:inScheme p:schema .

p:matchedPersonRef a owl:ObjectProperty ;
    rdfs:label "matchedPersonRef" ;
    rdfs:range p:Identifier ;
    skos:definition "References to other Person records where a cross-system match has been identified. Uses the Identifier structure." ;
    skos:inScheme p:schema .

p:primaryContactProfessional a owl:ObjectProperty ;
    rdfs:label "primaryContactProfessional" ;
    rdfs:range p:Identifier ;
    skos:definition "References to the primary professionals related to this person (e.g. care coordinators or a GP). Until the Professional standard is published, recorded using the Identifier structure (system + value)." ;
    skos:inScheme p:schema .

p:relatedPerson a owl:ObjectProperty ;
    rdfs:label "relatedPerson" ;
    rdfs:range p:PersonRelationship ;
    skos:definition "References to other people related to this person, with the kind of relationship." ;
    skos:inScheme p:schema .

p:telephone a owl:DatatypeProperty ;
    rdfs:label "telephone" ;
    rdfs:range xsd:string ;
    skos:definition "One or more telephone numbers." ;
    skos:inScheme p:schema .

sg:alias a owl:DatatypeProperty ;
    rdfs:label "alias" ;
    rdfs:range xsd:string ;
    skos:definition "Other names the entity is known by." ;
    skos:inScheme sg:schema .

sg:delivery a owl:ObjectProperty ;
    rdfs:label "delivery" ;
    rdfs:range sg:service-delivery ;
    skos:definition "The way the service is delivered." ;
    skos:inScheme sg:schema .

sg:finding a owl:ObjectProperty ;
    rdfs:label "finding" ;
    rdfs:range sg:Finding ;
    skos:definition "Observations or measurements made during the course of the episode." ;
    skos:inScheme sg:schema .

sg:measurement a owl:ObjectProperty ;
    rdfs:label "measurement" ;
    rdfs:range sg:Measurement ;
    skos:definition "Quantitative measurement(s) about the subject or their circumstances." ;
    skos:inScheme sg:schema .

sg:observation a owl:ObjectProperty ;
    rdfs:label "observation" ;
    rdfs:range sg:Observation ;
    skos:definition "Qualitative observation(s) about the subject or their circumstances." ;
    skos:inScheme sg:schema .

sg:relatedOrganisationRef a owl:ObjectProperty ;
    rdfs:label "relatedOrganisationRef" ;
    dct:title "relatedOrganisation" ;
    rdfs:range p:Identifier ;
    skos:definition "References (by Identifier) to Organisations associated with the entity." ;
    skos:inScheme sg:schema .

sg:relatedProfessionalObj a owl:ObjectProperty ;
    rdfs:label "relatedProfessionalObj" ;
    dct:title "relatedProfessional" ;
    rdfs:range sg:RelatedProfessional ;
    skos:definition "References to the Professional(s) involved, qualified by involvement." ;
    skos:inScheme sg:schema .

sg:relatedProfessionalRef a owl:ObjectProperty ;
    rdfs:label "relatedProfessionalRef" ;
    dct:title "relatedProfessional" ;
    rdfs:range p:Identifier ;
    skos:definition "References (by Identifier) to Professionals associated with the entity." ;
    skos:inScheme sg:schema .

sg:schema.owl.ttl a owl:Ontology ;
    rdfs:label "safeguarding" ;
    dct:license "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" ;
    dct:title "Safeguarding Standard Data Model" ;
    pav:version "1.0.0" ;
    skos:definition """A LinkML data model for the Safeguarding Standard: a common data model for recording the services, professionals, organisations, service episodes and life events involved in safeguarding and promoting the wellbeing of a person, to support multi-agency information sharing (MAIS).
The model is organised around five top-level entities - Organisation, Service, Professional, ServiceEpisode and LifeEvent - and the shared objects that link them together (Identifier, Name, Address, Contact). The shared objects are defined once by the Person Standard and imported from person-standard.yaml, so this schema reuses their p: ontology IRIs (p:Identifier, p:Name, p:Address, p:Contact) rather than redefining them. Coded fields draw their values from the controlled vocabularies (enums) declared below.""" .

sg:sgAddress a owl:ObjectProperty ;
    rdfs:label "sgAddress" ;
    dct:title "address" ;
    rdfs:range p:Address ;
    skos:definition "Physical location(s) of the entity." ;
    skos:inScheme sg:schema .

sg:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    rdfs:range xsd:string ;
    skos:definition "A finding that cannot be represented as an Observation or Measurement." ;
    skos:inScheme sg:schema .

p:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:isDeceased ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:dateOfBirth ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:sexCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:deceasedDate ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty p:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:ethnicityCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:genderCode ] ;
    skos:definition "The top-level record describing an individual. Consolidates the core identity attributes required to distinguish one person from another and to record relationships between individuals. This is the canonical base Person; the two conformance profiles tighten the cardinalities below." ;
    skos:exactMatch p:Person ;
    skos:inScheme p:schema .

p:UPRN a owl:DatatypeProperty ;
    rdfs:label "UPRN" ;
    rdfs:range xsd:string ;
    skos:definition "Unique Property Reference Number of the address." ;
    skos:inScheme p:schema .

p:USRN a owl:DatatypeProperty ;
    rdfs:label "USRN" ;
    rdfs:range xsd:string ;
    skos:definition "Unique Street Reference Number of the address." ;
    skos:inScheme p:schema .

p:addressUse a owl:ObjectProperty ;
    rdfs:label "addressUse" ;
    dct:title "use" ;
    rdfs:range p:address-use-code ;
    skos:definition "How this address is used - home, work, temp, etc." ;
    skos:inScheme p:schema .

p:city a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:range xsd:string ;
    skos:definition "City, town, or village." ;
    skos:inScheme p:schema .

p:contactName a owl:DatatypeProperty ;
    rdfs:label "contactName" ;
    dct:title "name" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the contact type (for example, \"Home\", \"Work\", \"Other\")." ;
    skos:inScheme p:schema .

p:date a owl:DatatypeProperty ;
    rdfs:label "date" ;
    rdfs:range xsd:date ;
    skos:definition "ISO 8601-formatted date (YYYY-MM-DD)." ;
    skos:inScheme p:schema .

p:dateOfBirth a owl:ObjectProperty ;
    rdfs:label "dateOfBirth" ;
    rdfs:range p:PartialDate ;
    skos:definition "The person's date of birth, with an optional accuracy indicator." ;
    skos:inScheme p:schema .

p:deceasedDate a owl:ObjectProperty ;
    rdfs:label "deceasedDate" ;
    rdfs:range p:PartialDate ;
    skos:definition "The person's date of death, with an optional accuracy indicator. isDeceased may be true without a known date." ;
    skos:inScheme p:schema .

p:ethnicityCode a owl:ObjectProperty ;
    rdfs:label "ethnicityCode" ;
    rdfs:range p:ethnicity-code ;
    skos:definition "The person's stated ethnicity, using the ONS 18+1 categories from the 2021 census. Statutorily required in adult social care; optional elsewhere." ;
    skos:inScheme p:schema .

p:familyName a owl:DatatypeProperty ;
    rdfs:label "familyName" ;
    rdfs:range xsd:string ;
    skos:definition "The surname or family name. Multi-valued to support compound or hyphenated family names recorded as separate parts." ;
    skos:inScheme p:schema .

p:genderCode a owl:ObjectProperty ;
    rdfs:label "genderCode" ;
    rdfs:range p:gender-code ;
    skos:definition "The person's stated gender." ;
    skos:inScheme p:schema .

p:givenName a owl:DatatypeProperty ;
    rdfs:label "givenName" ;
    rdfs:range xsd:string ;
    skos:definition "The first name and any middle names." ;
    skos:inScheme p:schema .

p:identifier a owl:ObjectProperty ;
    rdfs:label "identifier" ;
    rdfs:range p:Identifier ;
    skos:definition "Unique identifiers associated with the person (e.g. NHS number, internal case-management system ID)." ;
    skos:inScheme p:schema .

p:isDeceased a owl:DatatypeProperty ;
    rdfs:label "isDeceased" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the person is deceased." ;
    skos:inScheme p:schema .

p:line1 a owl:DatatypeProperty ;
    rdfs:label "line1" ;
    rdfs:range xsd:string ;
    skos:definition "Street address (e.g. \"1 High Street\") or care-of line." ;
    skos:inScheme p:schema .

p:line2 a owl:DatatypeProperty ;
    rdfs:label "line2" ;
    rdfs:range xsd:string ;
    skos:definition "Apartment, suite, unit, building, floor, etc." ;
    skos:inScheme p:schema .

p:name a owl:ObjectProperty ;
    rdfs:label "name" ;
    rdfs:range p:Name ;
    skos:definition "A name for the person, with a usage indicating its purpose (usual, maiden, nickname, etc.)." ;
    skos:inScheme p:schema .

p:nameUse a owl:ObjectProperty ;
    rdfs:label "nameUse" ;
    dct:title "use" ;
    rdfs:range p:name-use-code ;
    skos:definition "The purpose of this name instance - usual, official, former, etc." ;
    skos:inScheme p:schema .

p:preferredName a owl:DatatypeProperty ;
    rdfs:label "preferredName" ;
    rdfs:range xsd:string ;
    skos:definition "Any preferred given or middle name used by the person - for example, \"Joe\" where their legal first name is \"Joseph\"." ;
    skos:inScheme p:schema .

p:relationship a owl:ObjectProperty ;
    rdfs:label "relationship" ;
    rdfs:range p:person-relationship-code ;
    skos:definition "One or more codes describing the kind of relationship." ;
    skos:inScheme p:schema .

p:sexCode a owl:ObjectProperty ;
    rdfs:label "sexCode" ;
    rdfs:range p:phenotypic-sex-code ;
    skos:definition "Observed phenotypic sex, where recorded." ;
    skos:inScheme p:schema .

p:system a owl:DatatypeProperty ;
    rdfs:label "system" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The URI of the system or namespace within which the identifier is unique (e.g. https://fhir.nhs.uk/Id/nhs-number)." ;
    skos:inScheme p:schema .

p:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range xsd:string ;
    skos:definition "The identifier value, unique within the issuing system." ;
    skos:inScheme p:schema .

sg:Any a owl:Class ;
    rdfs:label "Any" ;
    skos:definition "An open value whose structure is defined and validated elsewhere, not by this standard. Serialised as an arbitrary JSON object." ;
    skos:exactMatch linkml:Any ;
    skos:inScheme sg:schema .

sg:LifeEvent a owl:Class ;
    rdfs:label "LifeEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:eventType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:sgIdentifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:subjectPerson ] ;
    skos:definition "A significant, time-bound occurrence in an individual's life that may have implications for their safety, wellbeing or development - for example attendance at A&E, a child being reported as missing, or an exclusion from school. Life events are not inherently positive or negative but can signal levels of risk, vulnerability or changing need." ;
    skos:exactMatch sg:LifeEvent ;
    skos:inScheme sg:schema .

sg:Organisation a owl:Class ;
    rdfs:label "Organisation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:organisationType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:sgIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:active ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:entityName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:contactMulti ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:relatedServiceRef ] ;
    skos:definition "An organisation involved in the safeguarding or wellbeing of a person - for example a local authority, an NHS trust, a school, or an education authority. Aligns with the FHIR Organization resource." ;
    skos:exactMatch sg:Organisation ;
    skos:inScheme sg:schema .

sg:Professional a owl:Class ;
    rdfs:label "Professional" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:sgIdentifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:professionalName ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:contactSingle ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:status ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:role ] ;
    skos:definition "An individual acting in a formal role within an organisation who has responsibilities relating to a person's safety, wellbeing, care or support - for example undertaking assessments, creating and monitoring plans, or sharing information in a multi-agency context." ;
    skos:exactMatch sg:Professional ;
    skos:inScheme sg:schema .

sg:Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:serviceType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:contactMulti ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:entityName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:active ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sg:costFrequency ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:sgIdentifier ] ;
    skos:definition "A service involved in the safeguarding or wellbeing of a person - the specific intervention or package of support delivered by one or more organisations (e.g. local authority social care, an emergency department, a general practice, or a school)." ;
    skos:exactMatch sg:Service ;
    skos:inScheme sg:schema .

sg:ServiceEpisode a owl:Class ;
    rdfs:label "ServiceEpisode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sg:outcome ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:relatedServiceRef ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:episodeType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:subjectPerson ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:timeInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sg:sgIdentifier ] ;
    skos:definition "A bounded period during which an individual receives a defined service, intervention, or package of support from a service or professional. It has a recognisable start and end point, though duration may vary from a single contact to sustained involvement over time." ;
    skos:exactMatch sg:ServiceEpisode ;
    skos:inScheme sg:schema .

sg:contactSingle a owl:ObjectProperty ;
    rdfs:label "contactSingle" ;
    dct:title "contact" ;
    rdfs:range p:Contact ;
    skos:definition "The professional's contact information (exactly one)." ;
    skos:inScheme sg:schema .

sg:costFrequency a owl:ObjectProperty ;
    rdfs:label "costFrequency" ;
    rdfs:range sg:service-cost-frequency ;
    skos:definition "The frequency at which the unit cost occurs." ;
    skos:inScheme sg:schema .

sg:endDateTime a owl:DatatypeProperty ;
    rdfs:label "endDateTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The end of the episode or life event, as an ISO 8601 date-time." ;
    skos:inScheme sg:schema .

sg:episodeType a owl:ObjectProperty ;
    rdfs:label "episodeType" ;
    dct:title "type" ;
    rdfs:range sg:episode-code ;
    skos:definition "Code(s) for the type of service episode." ;
    skos:inScheme sg:schema .

sg:eventType a owl:ObjectProperty ;
    rdfs:label "eventType" ;
    dct:title "type" ;
    rdfs:range sg:event-code ;
    skos:definition "Code(s) for the type of life event." ;
    skos:inScheme sg:schema .

sg:frequency a owl:ObjectProperty ;
    rdfs:label "frequency" ;
    rdfs:range sg:Any ;
    skos:definition "The frequency of the episode or life event, expressed as a [FHIR Timing](https://build.fhir.org/datatypes.html#Timing) datatype. This standard does not define or validate its structure; the value is an arbitrary JSON object conforming to FHIR Timing." ;
    skos:inScheme sg:schema .

sg:location a owl:DatatypeProperty ;
    rdfs:label "location" ;
    rdfs:range xsd:string ;
    skos:definition "Details about the location of the episode or life event." ;
    skos:inScheme sg:schema .

sg:measurementType a owl:ObjectProperty ;
    rdfs:label "measurementType" ;
    dct:title "type" ;
    rdfs:range sg:measurement-type ;
    skos:definition "The type of measurement." ;
    skos:inScheme sg:schema .

sg:measurementUnit a owl:ObjectProperty ;
    rdfs:label "measurementUnit" ;
    dct:title "unit" ;
    rdfs:range sg:measurement-unit ;
    skos:definition "The unit of measurement." ;
    skos:inScheme sg:schema .

sg:measurementValue a owl:DatatypeProperty ;
    rdfs:label "measurementValue" ;
    dct:title "value" ;
    rdfs:range xsd:decimal ;
    skos:definition "A decimal number representing the value of the measurement." ;
    skos:inScheme sg:schema .

sg:observationEndDate a owl:DatatypeProperty ;
    rdfs:label "observationEndDate" ;
    dct:title "endDate" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date at which this observation was made false (if now outdated)." ;
    skos:inScheme sg:schema .

sg:observationStartDate a owl:DatatypeProperty ;
    rdfs:label "observationStartDate" ;
    dct:title "startDate" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date at which this observation was first true, as an ISO 8601 date-time." ;
    skos:inScheme sg:schema .

sg:observationType a owl:DatatypeProperty ;
    rdfs:label "observationType" ;
    dct:title "type" ;
    rdfs:range xsd:string ;
    skos:definition "The type of observation, drawn from the Observation Type Vocabulary (e.g. NEET, free-school-meals, SEND.SpLD). The vocabulary is extensible (some codes carry dynamic sub-parts such as EAL.<ISO 639-1 code>), so it is modelled as an open string rather than a closed enumeration. See the ObservationType enum for the reference list of codes." ;
    skos:inScheme sg:schema .

sg:organisationType a owl:ObjectProperty ;
    rdfs:label "organisationType" ;
    dct:title "type" ;
    rdfs:range sg:organisation-code ;
    skos:definition "Code(s) for the kind of organisation." ;
    skos:inScheme sg:schema .

sg:outcome a owl:ObjectProperty ;
    rdfs:label "outcome" ;
    rdfs:range sg:episode-outcome ;
    skos:definition "Outcome of the episode for the subject." ;
    skos:inScheme sg:schema .

sg:person a owl:ObjectProperty ;
    rdfs:label "person" ;
    rdfs:range p:Identifier ;
    skos:definition "A reference (by Identifier) to a Person record involved in the episode or life event." ;
    skos:inScheme sg:schema .

sg:professional a owl:ObjectProperty ;
    rdfs:label "professional" ;
    rdfs:range p:Identifier ;
    skos:definition "A reference (by Identifier) to a Professional record involved in the episode or life event." ;
    skos:inScheme sg:schema .

sg:professionalName a owl:ObjectProperty ;
    rdfs:label "professionalName" ;
    dct:title "name" ;
    rdfs:range p:Name ;
    skos:definition "The professional's name." ;
    skos:inScheme sg:schema .

sg:role a owl:DatatypeProperty ;
    rdfs:label "role" ;
    rdfs:range xsd:string ;
    skos:definition "Text describing the professional's occupational role." ;
    skos:inScheme sg:schema .

sg:serviceType a owl:ObjectProperty ;
    rdfs:label "serviceType" ;
    dct:title "type" ;
    rdfs:range sg:service-code ;
    skos:definition "Code(s) for the kind of service." ;
    skos:inScheme sg:schema .

sg:startDateTime a owl:DatatypeProperty ;
    rdfs:label "startDateTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The start of the episode or life event, as an ISO 8601 date-time." ;
    skos:inScheme sg:schema .

sg:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:range xsd:boolean ;
    skos:definition "The professional's current working status." ;
    skos:inScheme sg:schema .

sg:timeInformation a owl:ObjectProperty ;
    rdfs:label "timeInformation" ;
    rdfs:range sg:TimeInformation ;
    skos:definition "Details about the timing of the episode or life event." ;
    skos:inScheme sg:schema .

p:PersonRelationship a owl:Class ;
    rdfs:label "PersonRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty p:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty p:relationship ] ;
    skos:definition "A typed reference from one person to another. The reference is by Identifier (so the related person may live in a different system) and is qualified by one or more relationship codes." ;
    skos:exactMatch p:PersonRelationship ;
    skos:inScheme p:schema .

p:accuracyIndicator a owl:DatatypeProperty ;
    rdfs:label "accuracyIndicator" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[AEU]{3}$" ] ) ] ) ] ;
    skos:definition "A three-character code in day-month-year order indicating which parts of the date are accurate (A), estimated (E), or unknown (U)." ;
    skos:inScheme p:schema .

<https://ns.socialcaredata.io/person/address-use-code#Billing> a owl:Class ;
    rdfs:label "billing" ;
    dct:title "Billing" ;
    rdfs:subClassOf p:address-use-code ;
    skos:definition "An address to be used to send bills, invoices, receipts etc." .

<https://ns.socialcaredata.io/person/address-use-code#Home> a owl:Class ;
    rdfs:label "home" ;
    dct:title "Home" ;
    rdfs:subClassOf p:address-use-code ;
    skos:definition "A communication address at a home." .

<https://ns.socialcaredata.io/person/address-use-code#Old> a owl:Class ;
